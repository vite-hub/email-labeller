# Jev through Vercel AI Gateway, model typesafe-ai/jev
AI_GATEWAY_API_KEY=

# Executor stores Gmail OAuth credentials in an org-owned connection.
EXECUTOR_URL=https://executor.onmax.me
EXECUTOR_API_KEY=
EXECUTOR_GMAIL_CONNECTION=gmail
# Optional Cloudflare Access service token for Executor
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Cloudflare Access settings for the production ViteHub Console
CF_ACCESS_TEAM_DOMAIN=onmax.cloudflareaccess.com
CF_ACCESS_AUD=

# Optional Gmail watch. Leave blank for five-minute polling.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# ViteHub's shared secret is preferred for admin endpoints.
# LABELLER_ADMIN_TOKEN remains a compatibility fallback.
VITEHUB_SECRET=
LABELLER_ADMIN_TOKEN=
LABELLER_DRY_RUN=true
LABELLER_TRASH_ENABLED=false
LABELLER_CLEANUP_ENABLED=false
LABELLER_MIN_CONFIDENCE=0.6

# Build-time deployment settings. Secrets above are configured separately on the Worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
# Optional custom domain. Otherwise Cloudflare uses workers.dev.
CLOUDFLARE_WORKER_DOMAIN=
