# Jev through Vercel AI Gateway (model typesafe-ai/jev)
AI_GATEWAY_API_KEY=

# Executor keeps the Gmail OAuth credential. Use its local API; the public URL is behind Cloudflare Access.
EXECUTOR_URL=http://127.0.0.1:4788
EXECUTOR_API_KEY=
EXECUTOR_GMAIL_CONNECTION=personalGmail
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Gmail push through an authenticated Pub/Sub push subscription
GMAIL_PUBSUB_TOPIC=projects/maxios-gog-mg-20260802/topics/email-labeller-gmail
PUBSUB_AUDIENCE=https://email-labeller.onmax.me/gmail/push
PUBSUB_SERVICE_ACCOUNT=email-labeller-push@maxios-gog-mg-20260802.iam.gserviceaccount.com
GMAIL_PUBSUB_SUBSCRIPTION=projects/maxios-gog-mg-20260802/subscriptions/email-labeller-gmail-push


# Bearer token for /api/preview and /api/sync
LABELLER_ADMIN_TOKEN=
# Set to false to change Gmail
LABELLER_DRY_RUN=true
# Set to true to let rules with `trash: true` move new messages to Trash
LABELLER_TRASH_ENABLED=false
# Set to true to apply cleanup rules once a day
LABELLER_CLEANUP_ENABLED=false
LABELLER_MIN_CONFIDENCE=0.6
