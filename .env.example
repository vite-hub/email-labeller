# Vercel AI Gateway key. Jev (typesafe-ai/jev) labels the mail no rule matches.
AI_GATEWAY_API_KEY=

# Executor v2 holds the Gmail OAuth credential in an org-owned account. EXECUTOR_API_KEY is a
# personal access token for this Worker only; EXECUTOR_GMAIL_ACCOUNT is the account ID (acc_…).
EXECUTOR_URL=https://executor.onmax.me
EXECUTOR_API_KEY=
EXECUTOR_GMAIL_ACCOUNT=
# Optional Cloudflare Access service token for Executor
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Cloudflare Access application that guards the production ViteHub Console at /_vitehub
CF_ACCESS_TEAM_DOMAIN=onmax.cloudflareaccess.com
CF_ACCESS_AUD=

# Optional instant delivery through a Gmail watch. Leave blank to check every five minutes.
# Full names: projects/<project>/topics/<topic> and projects/<project>/subscriptions/<subscription>
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
# The push subscription's audience and the email of its service account
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# Bearer token for /api/*. LABELLER_ADMIN_TOKEN is the old name, used only when VITEHUB_SECRET is empty.
VITEHUB_SECRET=
LABELLER_ADMIN_TOKEN=
# false applies decisions to Gmail. While true, nothing in Gmail changes.
LABELLER_DRY_RUN=true
# true lets rules with `trash: true` move mail to Trash
LABELLER_TRASH_ENABLED=false
# true runs the daily cleanup (also needs LABELLER_DRY_RUN=false)
LABELLER_CLEANUP_ENABLED=false
# The preset applies Jev's label only at or above this answer confidence
LABELLER_MIN_CONFIDENCE=0.6

# Read at build time. Set the secrets above on the Worker with `wrangler secret put`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
# Optional custom domain. Otherwise Cloudflare uses workers.dev.
CLOUDFLARE_WORKER_DOMAIN=
