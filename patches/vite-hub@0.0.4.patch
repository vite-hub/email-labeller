+import type { ConfiguredAgentDefinition } from "../../agent.js";
+
+export interface LabellerLabel {
+  description?: string;
+  color?: { textColor: string; backgroundColor: string };
+}
+export interface LabellerRule {
+  from?: string | readonly string[];
+  to?: string | readonly string[];
+  subject?: string | readonly string[];
+  body?: string | readonly string[];
+  listId?: string | readonly string[];
+  hasLabel?: string | readonly string[];
+  header?: Readonly<Record<string, string | readonly string[]>>;
+  not?: LabellerRule;
+  label?: string;
+  archive?: boolean;
+  read?: boolean;
+  star?: boolean;
+  trash?: boolean;
+}
+export interface LabellerAction {
+  archive?: boolean;
+  read?: boolean;
+  star?: boolean;
+  trash?: boolean;
+}
+export interface LabellerOptions {
+  labels: Readonly<Record<string, LabellerLabel>>;
+  rules: Readonly<Record<string, LabellerRule>>;
+  actions: Readonly<Record<string, LabellerAction>>;
+  bodyLimit: number;
+  dryRun: boolean;
+  minConfidence: number;
+  trashEnabled: boolean;
+  client?: (request: { method: "GET" | "PATCH" | "POST"; path: string; query?: Record<string, unknown>; body?: Record<string, unknown> }) => Promise<unknown>;
+}
+export declare const labeller: ConfiguredAgentDefinition<LabellerOptions>;
diff --git a/dist/agent/presets/labeller.js b/dist/agent/presets/labeller.js
new file mode 100644
index 0000000000000000000000000000000000000000..1e66b85bfbded0424112bf7fe883c19fbe1c73b8
--- /dev/null
+++ b/dist/agent/presets/labeller.js
@@ -0,0 +1,98 @@
+import { ask, defineAgent } from "../../agent.js";
+import { gmail } from "../channels.js";
+
+const text = (value, pattern) => {
+  if (pattern === undefined) return true;
+  const values = Array.isArray(value) ? value : [value ?? ""];
+  const patterns = Array.isArray(pattern) ? pattern : [pattern];
+  return values.some((item) => patterns.some((candidate) => {
+    if (typeof candidate !== "string") return false;
+    const match = /^\/(.+)\/([a-z]*)$/.exec(candidate);
+    if (!match) return String(item).toLowerCase().includes(candidate.toLowerCase());
+    try { return new RegExp(match[1], match[2]).test(String(item)); }
+    catch { return false; }
+  }));
+};
+
+const matches = (message, rule) => Boolean(
+  text(message.from, rule.from)
+  && text(message.to, rule.to)
+  && text(message.subject, rule.subject)
+  && text(message.body || message.snippet, rule.body)
+  && text(message.headers?.["list-id"] || "", rule.listId)
+  && text(message.labelIds, rule.hasLabel)
+  && Object.entries(rule.header || {}).every(([name, value]) => text(message.headers?.[name.toLowerCase()] || "", value))
+  && (!rule.not || !matches(message, rule.not))
+);
+
+const action = (value) => value && typeof value === "object" ? value : {};
+
+function ruleDecision(message, rules) {
+  for (const [name, rule] of Object.entries(rules || {})) {
+    if (matches(message, rule)) return { rule: name, ...rule };
+  }
+}
+
+function choice(result) {
+  if (typeof result?.label === "string") return result.label;
+  return result?.label?.choice;
+}
+
+/** A Gmail Agent that applies ordered rules, then asks Jev to choose a label. */
+export const labeller = defineAgent({
+  options: {
+    labels: {},
+    rules: {},
+    actions: {},
+    bodyLimit: 10000,
+    dryRun: false,
+    minConfidence: 0,
+    trashEnabled: false,
+    client: undefined,
+  },
+  configure: ({ labels, rules, actions, bodyLimit, dryRun, minConfidence, trashEnabled, client }) => {
+    const channel = gmail({ labels, bodyLimit, dryRun, client });
+    return defineAgent({
+      description: "Labels Gmail messages with ordered rules, then Jev.",
+      channels: { gmail: channel },
+      intercept: ({ input }) => {
+        const decision = input?.data && ruleDecision(input.data, rules);
+        if (!decision) return undefined;
+        const selected = decision.label;
+        if (!selected) return { label: "none", rule: decision.rule };
+        return {
+          label: selected,
+          rule: decision.rule,
+          archive: decision.archive === true,
+          read: decision.read === true,
+          star: decision.star === true,
+          trash: decision.trash === true && trashEnabled,
+        };
+      },
+      driver: {
+        ask: () => ({
+          label: ask.choice(
+            "Which Gmail label fits this email? Choose \"none\" if no label clearly fits.",
+            { ...Object.fromEntries(Object.entries(labels || {}).map(([name, value]) => [name, value?.description || name])), none: "No label clearly fits this email." },
+          ),
+        }),
+      },
+      hooks: {
+        async "agent:finish"({ message, result }) {
+          if (!message || message.channel !== "gmail" || !result) return;
+          const selected = choice(result);
+          if (!selected || selected === "none") return;
+          const rule = result.rule ? rules?.[result.rule] : undefined;
+          const selectedAction = rule ? action(rule) : action(actions?.[selected]);
+          const probability = typeof result.label === "object" ? result.label.probabilities?.[selected] : 1;
+          if (typeof probability === "number" && probability < minConfidence) return;
+          await message.label(selected);
+          if (selectedAction.archive) await message.archive();
+          if (selectedAction.read) await message.markRead();
+          if (selectedAction.star) await message.star();
+          if (selectedAction.trash && trashEnabled) await message.trash();
+        },
+      },
+    });
+  },
+});
